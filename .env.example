# Telegram API credentials from https://my.telegram.org
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_PHONE=+10000000000

# Telethon session file (without the .session extension). Grants full account access: keep it private.
TG_SESSION_PATH=data/tg_analyst

# PostgreSQL URL. Docker Compose sets this itself; this value is for running outside Docker
# against the Compose database (docker compose up -d db).
DATABASE_URL=postgresql+psycopg://tg_analyst:tg_analyst@localhost:5432/tg_analyst

# Sentiment backend: "vader" (English only, no model download) or "hf" (transformer model).
# For Russian chats use the small Russian model (~45 MB, ~70 msg/s on CPU); for other or mixed
# languages use cardiffnlp/twitter-xlm-roberta-base-sentiment (1.1 GB, ~4 msg/s, ~1.4 GB RAM).
SENTIMENT_BACKEND=hf
HF_SENTIMENT_MODEL=cointegrated/rubert-tiny-sentiment-balanced
# Insult/obscenity/threat scores, run with the hf backend (empty disables)
HF_TOXICITY_MODEL=cointegrated/rubert-tiny-toxicity

# Worker schedules (0 disables): fetch new messages + score them for every group, and
# re-check the last RECONCILE_DAYS against Telegram for edits and deletions.
AUTO_REFRESH_MINUTES=60
AUTO_RECONCILE_HOURS=24
RECONCILE_DAYS=30
# Rebuild conversation topics of every group every N hours (0 = only when queued by hand).
AUTO_TOPICS_HOURS=24

# Context topics: conversation threads embedded with a small model, then clustered
# (docs/CONTEXT_TOPICS.md). Empty HF_EMBEDDING_MODEL disables them. TOPIC_THRESHOLD is the
# cosine distance (on mean-centered vectors) below which threads in a quarter count as
# the same topic; TOPIC_MERGE_THRESHOLD joins quarters. Tuned per model.
HF_EMBEDDING_MODEL=cointegrated/rubert-tiny2
TOPIC_THRESHOLD=0.6
TOPIC_MERGE_THRESHOLD=0.5
# LLM titles and summaries for the TOPIC_SUMMARY_TOP largest topics of each group.
# Sends the text of three pseudonymized threads per topic to the provider; no key = off,
# topics then keep their keyword labels. Either an OpenAI-compatible API (Mistral:
# SUMMARY_BASE_URL=https://api.mistral.ai/v1, TOPIC_SUMMARY_MODEL=mistral-small-latest),
# which wins when set, or Claude (ANTHROPIC_API_KEY).
SUMMARY_BASE_URL=
SUMMARY_API_KEY=
ANTHROPIC_API_KEY=
TOPIC_SUMMARY_MODEL=claude-haiku-5-5
TOPIC_SUMMARY_TOP=25
