# Telegram API credentials from https://my.telegram.org
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_PHONE=+10000000000

# Telethon session file (without the .session extension). Grants full account access: keep it private.
TG_SESSION_PATH=data/tg_analyst

# PostgreSQL URL. Docker Compose sets this itself; this value is for running outside Docker
# against the Compose database (docker compose up -d db).
DATABASE_URL=postgresql+psycopg://tg_analyst:tg_analyst@localhost:5432/tg_analyst

# Sentiment backend: "vader" (English only, no model download) or "hf" (transformer model).
# For Russian chats use the small Russian model (~45 MB, ~70 msg/s on CPU); for other or mixed
# languages use cardiffnlp/twitter-xlm-roberta-base-sentiment (1.1 GB, ~4 msg/s, ~1.4 GB RAM).
SENTIMENT_BACKEND=hf
HF_SENTIMENT_MODEL=cointegrated/rubert-tiny-sentiment-balanced

# Worker schedules (0 disables): fetch new messages + score them for every group, and
# re-check the last RECONCILE_DAYS against Telegram for edits and deletions.
AUTO_REFRESH_MINUTES=60
AUTO_RECONCILE_HOURS=24
RECONCILE_DAYS=30
