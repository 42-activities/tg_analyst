# Telegram API credentials from https://my.telegram.org
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_PHONE=+10000000000

# Telethon session file (without the .session extension). Grants full account access: keep it private.
TG_SESSION_PATH=data/tg_analyst

# SQLAlchemy URL. SQLite by default; PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/tg_analyst
DATABASE_URL=sqlite:///data/tg_analyst.db
